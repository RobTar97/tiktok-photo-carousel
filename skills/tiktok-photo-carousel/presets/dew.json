{
  "name": "dew",
  "label": "Dew",
  "for": "routines, beauty editorial, product steps, annotated photo guides",
  "signature": "Soft natural photos in touching horizontal halves, bold rounded white sans type across the seam, and small translucent labels positioned around the subject. Based on supplied skincare references.",
  "theme": {
    "googleFonts": [
      "Nunito Sans:wght@700;800"
    ],
    "display": "Nunito Sans, Arial, sans-serif",
    "text": "Nunito Sans, Arial, sans-serif",
    "hand": "Nunito Sans, Arial, sans-serif",
    "displayWeight": 800,
    "sizeMax": 100,
    "ink": "#FFFFFF",
    "muted": "#FFFFFF",
    "accent": "#E0E3D4",
    "onAccent": "#33362F",
    "paper": "#EBEADF",
    "inkDark": "#33362F",
    "bg": "#33362F",
    "block": "#33362F",
    "grain": 0.015,
    "vignette": 0.04,
    "highlight": "plain"
  },
  "art": {},
  "templates": [
    "cover-routine",
    "routine-pair",
    "routine-note"
  ],
  "css": ".slide[data-preset='dew'] .layer-photo img{filter:saturate(.8) sepia(.04) contrast(.96)}.slide[data-preset='dew'] .headline{font-style:normal;text-transform:none;--tracking:-.02em;--leading:1.02;text-shadow:none}"
}
